    "unlockHelp": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入主密码后，在设备内解密并加载。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your master password to decrypt and load your memos on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスターパスワードを入力すると、この端末内で復号してメモを読み込みます。"
          }
        }
      }
    },
    "createHelp": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请设置至少 12 个字符的密码。密码无法找回，请妥善保管。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a password with at least 12 characters. It cannot be recovered, so keep it safe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12文字以上のパスワードを設定してください。復元できないため、大切に保管してください。"
          }
        }
      }
    },
    "passwordTooShort": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主密码至少需要 12 个字符。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The master password must have at least 12 characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスターパスワードは12文字以上にしてください。"
          }
        }
      }
    },

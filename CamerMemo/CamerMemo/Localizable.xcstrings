        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CamerMemo は非表示です"
          }
        }
      }
    },
    "unlockHeading": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {

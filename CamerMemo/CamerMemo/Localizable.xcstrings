    "emptyChangesNotice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空正文的未保存修改未被保留，已保存的备忘录不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsaved changes with empty text were not kept. Previously saved memos are unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文が空の未保存の変更は保持されませんでした。保存済みのメモに影響はありません。"
          }
        }
      }
    },
    "saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存失败：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できませんでした：%@"
          }
        }
      },
      "comment": "%@ is a localized error description. Keep the placeholder in every language."
    },
    "backgroundSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开应用前保存失败，未保存修改未被保留：%@"

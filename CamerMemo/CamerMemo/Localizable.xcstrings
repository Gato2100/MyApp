      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库格式不受支持或文件已损坏。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault format is unsupported or the file is damaged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫の形式が未対応、またはファイルが破損しています。"
          }
        }
      }
    },
    "cannotUnlock": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码错误或资料库无法验证。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password is incorrect or the vault could not be verified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが正しくないか、保管庫を検証できませんでした。"
          }
        }
      }
    },
    "cryptoFailure": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全生成密钥，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not generate a secure key. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な鍵を生成できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "invalidContent": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备忘录内容为空或资料库过大。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The memo text is empty or the vault is too large."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモの本文が空、または保管庫のサイズが大きすぎます。"
          }
        }
      }
    },
    "storageFailure": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问或写入资料库，请检查可用存储空间和文件访问权限后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access or write the vault. Check available storage and file access, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫へのアクセスまたは書き込みができません。空き容量とファイルのアクセス権を確認して、もう一度お試しください。"
          }
        }

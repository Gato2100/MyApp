    "saveHelp": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后加密写入设备。离开应用时，会自动保存非空修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memos are encrypted when saved. Nonempty changes are saved automatically when you leave the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存時に暗号化して端末に書き込みます。アプリを離れる際、本文が空でない変更は自動保存されます。"
          }
        }
      }
    },
